#cloud-config
package_update: true
package_upgrade: false
packages:
  - curl
  - git
  - jq
  - podman
  - python3
  - python3-pip
  - unzip

write_files:
  - path: /usr/local/bin/bootstrap-openclaw.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      OPENCLAW_REPO_URL='${openclaw_repo_url}'
      ACOS_REPO_URL='${acos_repo_url}'
      OPENCLAW_GATEWAY_TOKEN='${gateway_token}'
      OPENCLAW_GATEWAY_BIND='${gateway_bind}'
      OPENCLAW_GATEWAY_PORT='${gateway_port}'
      OCI_OPENAI_BASE_URL='${oci_openai_base_url}'
      OCI_OPENAI_MODEL_ID='${oci_openai_model_id}'
      OCI_GENAI_API_KEY="$(printf '%s' '${oci_genai_api_key_b64}' | base64 -d)"
      VAULT_SECRET_OCID='${vault_secret_ocid}'

      export DEBIAN_FRONTEND=noninteractive

      if [[ ! -d /opt/openclaw ]]; then
        git clone --depth 1 "${OPENCLAW_REPO_URL}" /opt/openclaw
      fi

      cd /opt/openclaw
      bash ./setup-podman.sh --quadlet

      install -d -m 700 -o openclaw -g openclaw /home/openclaw/.openclaw
      install -d -m 700 -o openclaw -g openclaw /home/openclaw/.openclaw/workspace

      if [[ -n "${ACOS_REPO_URL}" && ! -d /home/openclaw/.openclaw/workspace/acos ]]; then
        sudo -u openclaw git clone --depth 1 "${ACOS_REPO_URL}" /home/openclaw/.openclaw/workspace/acos || true
      fi

      if [[ -n "${VAULT_SECRET_OCID}" ]]; then
        if ! command -v oci >/dev/null 2>&1; then
          bash -c "$(curl -L https://raw.githubusercontent.com/oracle/oci-cli/master/scripts/install/install.sh)" -- --accept-all-defaults
        fi
        OCI_BIN="$(command -v oci || true)"
        if [[ -z "${OCI_BIN}" && -x /root/bin/oci ]]; then
          OCI_BIN="/root/bin/oci"
        fi
        set +e
        VAULT_KEY_RAW="$("${OCI_BIN}" secrets secret-bundle get \
          --secret-id "${VAULT_SECRET_OCID}" \
          --auth instance_principal \
          --query 'data."secret-bundle-content".content' \
          --raw-output 2>/tmp/openclaw-vault.err)"
        VAULT_RC=$?
        set -e
        if [[ ${VAULT_RC} -eq 0 && -n "${VAULT_KEY_RAW}" ]]; then
          OCI_GENAI_API_KEY="$(printf '%s' "${VAULT_KEY_RAW}" | base64 -d)"
        fi
      fi

      cat > /home/openclaw/.openclaw/.env <<ENVFILE
      OPENCLAW_GATEWAY_TOKEN=${OPENCLAW_GATEWAY_TOKEN}
      OPENCLAW_GATEWAY_BIND=${OPENCLAW_GATEWAY_BIND}
      OPENCLAW_GATEWAY_PORT=${OPENCLAW_GATEWAY_PORT}
      OPENCLAW_OCI_OPENAI_BASE_URL=${OCI_OPENAI_BASE_URL}
      OPENCLAW_OCI_OPENAI_MODEL_ID=${OCI_OPENAI_MODEL_ID}
      OPENCLAW_OCI_GENAI_KEY=${OCI_GENAI_API_KEY}
      ENVFILE

      chown openclaw:openclaw /home/openclaw/.openclaw/.env
      chmod 600 /home/openclaw/.openclaw/.env

      if [[ -n "${OCI_OPENAI_BASE_URL}" && -n "${OCI_OPENAI_MODEL_ID}" && -n "${OCI_GENAI_API_KEY}" ]]; then
        cat > /home/openclaw/.openclaw/openclaw.json <<'CONFIGEOF'
        {
          gateway: { mode: "local" },
          agents: {
            defaults: {
              model: { primary: "oci-genai/${OPENCLAW_OCI_OPENAI_MODEL_ID}" },
              models: {
                "oci-genai/${OPENCLAW_OCI_OPENAI_MODEL_ID}": { alias: "OCI GenAI" }
              }
            }
          },
          models: {
            mode: "merge",
            providers: {
              "oci-genai": {
                baseUrl: "${OPENCLAW_OCI_OPENAI_BASE_URL}",
                apiKey: "${OPENCLAW_OCI_GENAI_KEY}",
                api: "openai-completions",
                models: [
                  {
                    id: "${OPENCLAW_OCI_OPENAI_MODEL_ID}",
                    name: "OCI GenAI",
                    reasoning: false,
                    input: ["text"],
                    contextWindow: 128000,
                    maxTokens: 8192
                  }
                ]
              }
            }
          }
        }
      CONFIGEOF
      else
        cat > /home/openclaw/.openclaw/openclaw.json <<'CONFIGEOF'
        { gateway: { mode: "local" } }
      CONFIGEOF
      fi

      chown openclaw:openclaw /home/openclaw/.openclaw/openclaw.json
      chmod 600 /home/openclaw/.openclaw/openclaw.json

      if systemctl --machine openclaw@ --user restart openclaw.service >/tmp/openclaw-systemd.log 2>&1; then
        echo "openclaw.service restarted via systemd user service"
      else
        sudo -u openclaw /home/openclaw/run-openclaw-podman.sh launch || true
      fi

runcmd:
  - [/usr/local/bin/bootstrap-openclaw.sh]
